# Discord Developer Portal (https://discord.com/developers/applications) で取得したBotトークン
DISCORD_BOT_TOKEN=your_bot_token_here

# /proxy のデフォルト値
DEFAULT_CONCURRENCY=200
DEFAULT_TIMEOUT=6

# 生存チェックに使う検証先URL (JSONで headers を返すエンドポイント)
CHECK_URL=http://httpbin.org/get

# ヘルスチェックサーバーの待受ポート。Renderではプラットフォームが自動注入するため
# 通常は自分で設定不要 (ローカル実行時のみ未設定なら8080が使われる)
PORT=8080
